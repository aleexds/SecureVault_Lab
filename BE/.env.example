NODE_ENV=development
PORT=3000

# MySQL local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=securevault
DB_TEST_NAME=securevault_test

# Usuario de la app (solo DML)
DB_USER=securevault_app
DB_PASSWORD=

# Usuario administrador (migraciones / creación de BD)
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

DB_SSL=false

# Secretos de la aplicación
DATA_ENCRYPTION_KEY=
SESSION_SECRET=

CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Producción (Railway / Nube) ---
# Opción A (Variables individuales de MySQL o provistas por Railway):
# DB_HOST=mysql.railway.internal (o host público TCP de Railway)
# DB_PORT=3306
# DB_NAME=railway
# DB_USER=root (o securevault_app)
# DB_PASSWORD=tu_password
# DB_SSL=false (o true si tu proveedor exige TLS externo)
#
# Opción B (URL completa provista por Railway o MySQL Cloud):
# DATABASE_URL=mysql://user:password@host:port/database
# MIGRATION_DATABASE_URL=mysql://admin:password@host:port/database
#
# Configuración del servidor y CORS en Railway:
# NODE_ENV=production
# PORT=3000
# HOST=0.0.0.0
# TRUST_PROXY=1
# CORS_ORIGIN=https://tu-frontend.up.railway.app
