NODE_ENV=development
PORT=3000

# MySQL local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=securevault
DB_TEST_NAME=securevault_test

# Usuario de la app (solo DML)
DB_USER=securevault_app
DB_PASSWORD=

# Usuario administrador (migraciones / creación de BD)
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

DB_SSL=false

# Secretos de la aplicación
DATA_ENCRYPTION_KEY=
SESSION_SECRET=

CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Solo producción (Render) ---
# NODE_ENV=production
# DATABASE_URL=mysql://securevault_app:<PASSWORD>@host:3306/securevault_db
# MIGRATION_DATABASE_URL=mysql://<admin>:<PASSWORD>@host:3306/securevault_db
# DB_SSL_CA=<certificado CA del proveedor en PEM>
# TRUST_PROXY=1
# CORS_ORIGIN=https://securevault.onrender.com
